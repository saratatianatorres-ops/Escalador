<?xml version="1.0"?>
<!--
  Robot trepador "Escalador": modelo sacado del ensamble de SolidWorks
  hardware/cad/Diseno_2.SLDASM (herramientas/cad/solidworks/ explica cómo).

  Dos bases "Base 2" iguales y fijas (la de atrás girada 180°), unidas por el lado de las
  repisas. Cada base lleva un A2217 sobre su "Agarre_motor" en el centro del ducto. Las cuatro
  llantas JSumo SLT20 van POR FUERA de la placa, en las esquinas, con un N20 cada una apoyado
  sobre el borde de la placa. La placa queda a 1,5 mm del suelo (efecto suelo).

        atrás                                   adelante
     o ┌──────────────┬──┬──┬──────────────┐ o
       │   ducto      │re│re│   ducto      │      468 × 260 × 71,5 mm (con llantas)
       │  (Base 2-2)  │pi│pi│  (Base 2-1)  │
     o └──────────────┴sa┴sa┴──────────────┘ o
                         x = 0

  Ejes: x adelante, y izquierda, z arriba. Origen de base_link: centro del robot, a la altura
  de la cara inferior de la placa. sim:=true añade los plugins de Gazebo Harmonic.
-->
<robot name="escalador" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:arg name="sim" default="false"/>
  <!-- posición de los ejes de las llantas desde el centro (m). Ensamble: 0,2175 -->
  <xacro:arg name="rueda_x" default="0.2175"/>

  <!-- ================= Medidas del ensamble (m) ================= -->
  <xacro:property name="largo_base"    value="0.225"/>   <!-- cada base, en x -->
  <xacro:property name="ancho"         value="0.216"/>
  <xacro:property name="esp_placa"     value="0.010"/>
  <xacro:property name="ancho_repisa"  value="0.026"/>
  <xacro:property name="alto_repisa"   value="0.057"/>
  <xacro:property name="ducto_x"       value="0.127"/>   <!-- centro del ducto y del A2217 -->
  <xacro:property name="ducto_r"       value="0.0975"/>
  <xacro:property name="ducto_alto"    value="0.070"/>

  <!-- Llantas JSumo SLT20 (Ø33 × 21 mm, banda de 18 mm) -->
  <xacro:property name="r_rueda"       value="0.0165"/>
  <xacro:property name="ancho_rueda"   value="0.021"/>
  <xacro:property name="ancho_banda"   value="0.018"/>
  <xacro:property name="rueda_x"       value="$(arg rueda_x)"/>  <!-- ensamble: 0,2175 (9 mm por delante del chasis) -->
  <xacro:property name="rueda_y"       value="0.1195"/>  <!-- vía 239 mm, por fuera de la placa -->
  <xacro:property name="rueda_z"       value="0.0150"/>  <!-- eje 15 mm POR ENCIMA de la cara inferior -->
  <xacro:property name="via"           value="${2*rueda_y}"/>
  <xacro:property name="par_rueda"     value="0.2"/>     <!-- N·m máximo por N20 -->
  <xacro:property name="vel_rueda"     value="30"/>
  <xacro:property name="mu_rueda"      value="1.0"/>

  <!-- N20 (caja de 12 × 13,2 × 35,9 mm) sobre el borde de la placa, junto a cada llanta -->
  <xacro:property name="n20_y"         value="0.101"/>
  <xacro:property name="n20_z"         value="0.0146"/>

  <!-- Hélices dentro de los ductos, encima del A2217 -->
  <xacro:property name="d_helice"      value="0.178"/>   <!-- 7 pulgadas: ajusta a la tuya -->
  <xacro:property name="altura_helice" value="0.062"/>

  <!-- Masas (kg), hardware/lista_materiales.md. Total = 1,225 kg:
       bases 2 × 220 g + todo lo demás 785 g (peor caso que da el equipo) -->
  <xacro:property name="masa_bases"    value="0.440"/>
  <!-- 785 g − motores 153 − hélices 19 − N20 52 − llantas 48 = 513 g: batería, porta pilas,
       BMS, 2 ESC, PCB, ESP32, buck, regletas, IMU, puente H, tornillería y cables -->
  <xacro:property name="masa_electronica" value="0.513"/>
  <xacro:property name="z_electronica" value="0.030"/>
  <xacro:property name="masa_motor"    value="0.0765"/>  <!-- cada A2217 (153 g el par) -->
  <xacro:property name="masa_helice"   value="0.0095"/>
  <xacro:property name="masa_n20"      value="0.013"/>
  <xacro:property name="masa_rueda"    value="0.012"/>
  <xacro:property name="masa_chasis"   value="${masa_bases + masa_electronica}"/>
  <xacro:property name="z_cm_chasis"   value="${(masa_bases*0.0172 + masa_electronica*z_electronica)/masa_chasis}"/>

  <xacro:property name="mallas" value="package://robot_trepador_description/meshes"/>

  <!-- ================= Materiales ================= -->
  <material name="base">    <color rgba="0.23 0.44 0.71 1"/></material>
  <material name="base2">   <color rgba="0.30 0.52 0.80 1"/></material>
  <material name="naranja"> <color rgba="0.95 0.45 0.10 1"/></material>
  <material name="gris">    <color rgba="0.60 0.62 0.65 1"/></material>
  <material name="negro">   <color rgba="0.15 0.15 0.17 1"/></material>
  <material name="helice">  <color rgba="0.85 0.85 0.90 0.55"/></material>

  <!-- ================= Chasis: las dos bases y los soportes de los A2217 ================= -->
  <link name="base_link">
    <visual>
      <geometry><mesh filename="${mallas}/base_delantera.stl"/></geometry>
      <material name="base"/>
    </visual>
    <visual>
      <geometry><mesh filename="${mallas}/base_trasera.stl"/></geometry>
      <material name="base2"/>
    </visual>
    <visual>
      <geometry><mesh filename="${mallas}/soporte_motor_delantero.stl"/></geometry>
      <material name="gris"/>
    </visual>
    <visual>
      <geometry><mesh filename="${mallas}/soporte_motor_trasero.stl"/></geometry>
      <material name="gris"/>
    </visual>
    <!-- franja naranja = delante (igual que en la vista 3D de la interfaz) -->
    <visual>
      <origin xyz="${largo_base - 0.004} 0 ${esp_placa + 0.002}"/>
      <geometry><box size="0.008 ${ancho - 0.02} 0.004"/></geometry>
      <material name="naranja"/>
    </visual>

    <!-- Colisiones con formas simples (más rápidas y estables que la malla) -->
    <collision>  <!-- placa -->
      <origin xyz="0 0 ${esp_placa/2}"/>
      <geometry><box size="${2*largo_base} ${ancho} ${esp_placa}"/></geometry>
    </collision>
    <collision>  <!-- ducto delantero -->
      <origin xyz="${ducto_x} 0 ${(esp_placa + ducto_alto)/2}"/>
      <geometry><cylinder radius="${ducto_r}" length="${ducto_alto - esp_placa}"/></geometry>
    </collision>
    <collision>  <!-- ducto trasero -->
      <origin xyz="${-ducto_x} 0 ${(esp_placa + ducto_alto)/2}"/>
      <geometry><cylinder radius="${ducto_r}" length="${ducto_alto - esp_placa}"/></geometry>
    </collision>
    <collision>  <!-- repisas -->
      <origin xyz="0 0 ${(esp_placa + alto_repisa)/2}"/>
      <geometry><box size="${2*ancho_repisa} ${ancho} ${alto_repisa - esp_placa}"/></geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 ${z_cm_chasis}"/>
      <mass value="${masa_chasis}"/>
      <inertia ixx="${0.004479*masa_bases + masa_electronica*(0.15*0.15 + 0.04*0.04)/12}" ixy="0" ixz="0"
               iyy="${0.016294*masa_bases + masa_electronica*(0.10*0.10 + 0.04*0.04)/12}" iyz="0"
               izz="${0.019963*masa_bases + masa_electronica*(0.10*0.10 + 0.15*0.15)/12}"/>
    </inertial>
  </link>

  <!-- ================= Llantas y N20 ================= -->
  <xacro:macro name="rueda" params="nombre sx sy lado">
    <link name="rueda_${nombre}">
      <visual>
        <geometry><mesh filename="${mallas}/llanta_${lado}.stl"/></geometry>
        <material name="naranja"/>
      </visual>
      <collision>
        <origin rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="${r_rueda}" length="${ancho_banda}"/></geometry>
      </collision>
      <inertial>
        <mass value="${masa_rueda}"/>
        <inertia ixx="${masa_rueda*(3*r_rueda*r_rueda + ancho_rueda*ancho_rueda)/12}" ixy="0" ixz="0"
                 iyy="${masa_rueda*r_rueda*r_rueda/2}" iyz="0"
                 izz="${masa_rueda*(3*r_rueda*r_rueda + ancho_rueda*ancho_rueda)/12}"/>
      </inertial>
    </link>
    <joint name="rueda_${nombre}_joint" type="continuous">
      <parent link="base_link"/>
      <child link="rueda_${nombre}"/>
      <origin xyz="${sx*rueda_x} ${sy*rueda_y} ${rueda_z}"/>
      <axis xyz="0 1 0"/>
      <limit effort="${par_rueda}" velocity="${vel_rueda}"/>
    </joint>
    <gazebo reference="rueda_${nombre}">
      <mu1>${mu_rueda}</mu1>
      <mu2>${mu_rueda}</mu2>
    </gazebo>

    <!-- N20 fijo sobre el borde de la placa; su eje entra en la llanta -->
    <link name="n20_${nombre}">
      <visual>
        <geometry><box size="0.012 0.0359 0.0132"/></geometry>
        <material name="gris"/>
      </visual>
      <inertial>
        <mass value="${masa_n20}"/>
        <inertia ixx="1.6e-6" ixy="0" ixz="0" iyy="3.5e-7" iyz="0" izz="1.6e-6"/>
      </inertial>
    </link>
    <joint name="n20_${nombre}_joint" type="fixed">
      <parent link="base_link"/>
      <child link="n20_${nombre}"/>
      <origin xyz="${sx*rueda_x} ${sy*n20_y} ${n20_z}"/>
    </joint>
  </xacro:macro>

  <xacro:rueda nombre="del_izq" sx="1"  sy="1"  lado="izq"/>
  <xacro:rueda nombre="del_der" sx="1"  sy="-1" lado="der"/>
  <xacro:rueda nombre="tra_izq" sx="-1" sy="1"  lado="izq"/>
  <xacro:rueda nombre="tra_der" sx="-1" sy="-1" lado="der"/>

  <!-- ================= A2217 y hélices (una por ducto) ================= -->
  <!-- El eje de la hélice apunta a −z: el empuje positivo aprieta el robot contra la superficie -->
  <xacro:macro name="helice" params="nombre sx">
    <link name="motor_${nombre}">
      <visual>
        <geometry><mesh filename="${mallas}/a2217_${nombre}.stl"/></geometry>
        <material name="negro"/>
      </visual>
      <inertial>
        <origin xyz="${sx*ducto_x} 0 0.035"/>
        <mass value="${masa_motor}"/>
        <inertia ixx="1.5e-5" ixy="0" ixz="0" iyy="1.5e-5" iyz="0" izz="7e-6"/>
      </inertial>
    </link>
    <joint name="motor_${nombre}_joint" type="fixed">
      <parent link="base_link"/>
      <child link="motor_${nombre}"/>
    </joint>

    <link name="helice_${nombre}">
      <visual>
        <geometry><cylinder radius="${d_helice/2}" length="0.002"/></geometry>
        <material name="helice"/>
      </visual>
      <visual>
        <geometry><box size="${d_helice} 0.014 0.004"/></geometry>
        <material name="gris"/>
      </visual>
      <inertial>
        <mass value="${masa_helice}"/>
        <inertia ixx="${masa_helice*d_helice*d_helice/48}" ixy="0" ixz="0"
                 iyy="${masa_helice*d_helice*d_helice/48}" iyz="0"
                 izz="${masa_helice*d_helice*d_helice/24}"/>
      </inertial>
    </link>
    <joint name="helice_${nombre}_joint" type="continuous">
      <parent link="base_link"/>
      <child link="helice_${nombre}"/>
      <origin xyz="${sx*ducto_x} 0 ${altura_helice}"/>
      <axis xyz="0 0 -1"/>
    </joint>
  </xacro:macro>

  <xacro:helice nombre="delantero" sx="1"/>
  <xacro:helice nombre="trasero"   sx="-1"/>

  <!-- ================= IMU (MPU6050), en la zona de las repisas ================= -->
  <link name="imu_link"/>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 ${esp_placa + 0.02}"/>
  </joint>

  <!-- ================= Plugins de Gazebo Harmonic ================= -->
  <xacro:if value="$(arg sim)">
    <gazebo reference="base_link">
      <mu1>0.3</mu1>
      <mu2>0.3</mu2>
    </gazebo>

    <gazebo reference="imu_link">
      <sensor name="imu" type="imu">
        <always_on>true</always_on>
        <update_rate>50</update_rate>
        <topic>/robot/imu_gz</topic>
        <gz_frame_id>imu_link</gz_frame_id>
      </sensor>
    </gazebo>

    <gazebo>
      <!-- Tracción diferencial: los dos N20 de cada lado reciben la misma orden -->
      <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
        <left_joint>rueda_del_izq_joint</left_joint>
        <left_joint>rueda_tra_izq_joint</left_joint>
        <right_joint>rueda_del_der_joint</right_joint>
        <right_joint>rueda_tra_der_joint</right_joint>
        <wheel_separation>${via}</wheel_separation>
        <wheel_radius>${r_rueda}</wheel_radius>
        <topic>/model/escalador/cmd_vel</topic>
        <odom_topic>/model/escalador/odometria_plana</odom_topic>
        <tf_topic>/model/escalador/tf_plana</tf_topic>
      </plugin>

      <!-- Succión de cada ducto: reciben el empuje en N (std_msgs/Float64 desde ROS) -->
      <xacro:macro name="empuje" params="nombre topico">
        <plugin filename="gz-sim-thruster-system" name="gz::sim::systems::Thruster">
          <namespace>escalador</namespace>
          <joint_name>helice_${nombre}_joint</joint_name>
          <topic>${topico}</topic>
          <thrust_coefficient>0.1</thrust_coefficient>
          <fluid_density>1.2</fluid_density>
          <propeller_diameter>${d_helice}</propeller_diameter>
          <velocity_control>true</velocity_control>
          <use_angvel_cmd>false</use_angvel_cmd>
          <min_thrust_cmd>0</min_thrust_cmd>
          <max_thrust_cmd>40</max_thrust_cmd>
        </plugin>
      </xacro:macro>
      <xacro:empuje nombre="delantero" topico="empuje_delantero"/>
      <xacro:empuje nombre="trasero"   topico="empuje_trasero"/>

      <!-- Posición real en 3D (también en la pared y el techo) para RViz -->
      <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
        <odom_frame>odom</odom_frame>
        <robot_base_frame>base_link</robot_base_frame>
        <odom_publish_frequency>50</odom_publish_frequency>
        <dimensions>3</dimensions>
        <odom_topic>/model/escalador/odometria</odom_topic>
        <tf_topic>/model/escalador/tf</tf_topic>
      </plugin>

      <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
        <topic>/model/escalador/joint_states</topic>
      </plugin>
    </gazebo>
  </xacro:if>

</robot>
